 "simulations": [],
 "extensions": {
  "material-state": {
   "format": "resonant.material-state",
   "version": 1,
   "studies": [
    {
     "id": "st-evolve-plate",
     "name": "Heat for 20 minutes",
     "model": "coupled.evolution",
     "system": "sys-thermomechanical",
     "parameters": {
      "duration": 1200.0,
      "steps": 12,
      "substeps": 4
     }
    }
   ],
   "records": []
  },
  "multiphysics": {
   "format": "resonant.multiphysics",
   "version": 1,
   "systems": [
    {
     "format": "resonant.physical-system",
     "version": 1,
     "id": "sys-thermomechanical",
     "name": "Constrained heated plate",
     "description": "A 10 mm polymer plate heated inside (50 kW/m^3), held laterally: it thickens and builds compressive stress as it warms. A negligible 1 GHz wave carries the deformed thickness.",
     "geometry": {
      "kind": "layered-slab",
      "lateralArea": 0.01
     },
     "environment": {
      "ambientTemperature": 293.15
     },
     "regions": [
      {
       "id": "plate",
       "name": "Plate",
       "materialId": "mat-ex-polymer",
       "thickness": 0.01,
       "cells": 20,
       "objectId": "ex-mst-plate"
      }
     ],
     "domains": [
      {
       "id": "heat",
       "kind": "thermal",
       "solver": "thermal.conduction.fv",
       "settings": {
        "volumetricSource": 50000.0,
        "faces": {
         "-z": {
          "kind": "convective",
          "h": 5.0
         },
         "+z": {
          "kind": "convective",
          "h": 5.0
         }
        }
       }
      },
      {
       "id": "solid",
       "kind": "mechanical",
       "solver": "mechanics.fe.solid-column",
       "settings": {
        "lateral": "constrained"
       }
      },
      {
       "id": "em",
       "kind": "electromagnetic",
       "solver": "em.layered.transfer-matrix",
       "settings": {
        "frequencyHz": 1000000000.0,
        "incidentIntensity": 1e-09
       }
      }
     ],
     "couplings": [
      {
       "id": "expand",
       "model": "thermal.expansion",
       "from": "heat",
       "to": "solid"
      },
      {
       "id": "deform",
       "model": "mechanics.deformation-to-geometry",
       "from": "solid",
       "to": "em"
      }
     ],
     "materialLaws": [],
     "scheme": {
      "kind": "iterative",
      "maxIterations": 50,
      "temperatureTolerance": 1e-06,
      "geometryTolerance": 1e-12
     }
    }
   ]
  }
 }
}