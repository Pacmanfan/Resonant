{
  "application": {
    "name": "Resonant",
    "version": "0.1.0"
  },
  "extensions": {
    "acoustics": {
      "frequencyHz": 40000.0,
      "medium": {
        "attenuation": 0.0,
        "basis": "Theoretical: dry air as an ideal gas at 101 325 Pa (gamma 1.4, R 287.05 J/(kg K)). Humidity and absorption are not modelled.",
        "density": 1.2041183163746156,
        "name": "Air",
        "soundSpeed": 343.23197767690584,
        "temperatureK": 293.15
      },
      "memoryLimitBytes": 1073741824,
      "model": "acoustic.reflector.kirchhoff",
      "propagation": {
        "includeAttenuation": true,
        "includeDirectivity": true,
        "minimumDistance": 0.0001
      },
      "reflectorElementsPerWavelength": 5.0
    },
    "optimization": {
      "problems": [
        {
          "adapter": "acoustic",
          "adapterConfig": {
            "focus": "ex-opt-b-focus"
          },
          "algorithm": {
            "algorithm": "sweep",
            "checkpointEvery": 0,
            "gradientStep": 0.0001,
            "initialStep": 0.15,
            "maxEvaluations": 100,
            "maxSeconds": 0.0,
            "memoryBudgetBytes": 0.0,
            "parallel": 0,
            "pointsPerVariable": 31,
            "populationSize": 0,
            "samples": 32,
            "seed": 1,
            "tolerance": 1e-06
          },
          "constraints": [],
          "description": "Sweep the focal length of a parabolic reflector (aperture 200 mm) lit by a source 2 m away for the largest pressure at a target 80 mm in front of its vertex, with the Kirchhoff reflector model. The mirror equation 1/f = 1/2 m + 1/0.08 m predicts f = 76.9 mm; the candidates show how sharply the focus depends on it.",
          "designSpace": {
            "derived": [],
            "variables": [
              {
                "active": true,
                "binding": "object/ex-opt-b-reflector/geometry/aperture",
                "group": "Reflector",
                "id": "object/ex-opt-b-reflector/geometry/aperture",
                "initial": 0.2,
                "kind": "continuous",
                "label": "Reflector: Aperture diameter",
                "locked": true,
                "lower": 0.05,
                "role": "dimension",
                "unit": "m",
                "upper": 0.8
              },
              {
                "active": true,
                "binding": "object/ex-opt-b-reflector/geometry/focalLength",
                "group": "Reflector",
                "id": "object/ex-opt-b-reflector/geometry/focalLength",
                "initial": 0.06,
                "kind": "continuous",
                "label": "Reflector: Focal length",
                "locked": false,
                "lower": 0.05,
                "role": "dimension",
                "unit": "m",
                "upper": 0.11
              },
              {
                "active": true,
                "binding": "object/ex-opt-b-reflector/geometry/thickness",
                "group": "Reflector",
                "id": "object/ex-opt-b-reflector/geometry/thickness",
                "initial": 0.003,
                "kind": "continuous",
                "label": "Reflector: Thickness",
                "locked": true,
                "lower": 0.00075,
                "role": "thickness",
                "unit": "m",
                "upper": 0.012
              }
            ]
          },
          "format": "resonant.optimization.problem",
          "id": "ex-opt-b-reflector",
          "model": "acoustic.reflector.kirchhoff",
          "name": "Reflector geometry for the focus",
          "objectives": [
            {
              "id": "focus",
              "label": "Pressure at the focus",
              "quantity": "focus.pressure",
              "scale": 1.0,
              "sense": "maximize",
              "target": 0.0,
              "unit": "",
              "weight": 1.0
            }
          ],
          "robust": {
            "enabled": false,
            "k": 1.0,
            "measure": "mean",
            "parameters": [],
            "requiredProbability": 1.0,
            "samples": 16,
            "seed": 7
          },
          "template": "acoustic.reflector-focus",
          "validationModel": "",
          "version": 1
        }
      ],
      "revisions": [],
      "runs": [],
      "version": 1
    }
  },
  "format": "resonant-project",
