  "multiphysics": {
   "format": "resonant.multiphysics",
   "version": 1,
   "systems": [
    {
     "format": "resonant.physical-system",
     "version": 1,
     "id": "sys-microwave-food",
     "name": "Microwave-heated food layer",
     "description": "A 15 mm food layer in a 2.45 GHz plane wave of 10 kW/m^2: the wave's absorbed power becomes heat, which leaves by convection.",
     "geometry": {
      "kind": "layered-slab",
      "lateralArea": 0.02
     },
     "environment": {
      "ambientTemperature": 293.15
     },
     "regions": [
      {
       "id": "food",
       "name": "Food",
       "materialId": "mat-ex-acc-food",
       "thickness": 0.015,
       "cells": 40,
       "objectId": "ex-acc-food"
      }
     ],
     "domains": [
      {
       "id": "em",
       "kind": "electromagnetic",
       "solver": "em.layered.transfer-matrix",
       "settings": {
        "frequencyHz": 2450000000.0,
        "incidentIntensity": 10000.0
       }
      },
      {
       "id": "heat",
       "kind": "thermal",
       "solver": "thermal.conduction.fv",
       "settings": {
        "faces": {
         "-z": {
          "kind": "convective",
          "h": 10.0
         },
         "+z": {
          "kind": "convective",
          "h": 10.0
         }
        }
       }
      }
     ],
     "couplings": [
      {
       "id": "absorb",
       "model": "em.absorption-to-heat",
       "from": "em",
       "to": "heat"
      }
     ],
     "materialLaws": [],
     "scheme": {
      "kind": "one-way",
      "maxIterations": 20,
      "temperatureTolerance": 1e-07
     }
    }
   ]
  }
 }
