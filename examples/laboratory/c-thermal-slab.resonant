  "multiphysics": {
   "format": "resonant.multiphysics",
   "version": 1,
   "systems": [
    {
     "format": "resonant.physical-system",
     "version": 1,
     "id": "sys-lab-slab",
     "name": "Heated polymer sheet",
     "description": "A 40 mm sheet with 20 kW/m^3 of internal heating, cooled by forced convection (50 W/(m^2 K)) on both faces: a Biot number near 2, so the mid-plane temperature depends on the conductivity.",
     "geometry": {
      "kind": "layered-slab",
      "lateralArea": 0.01
     },
     "environment": {
      "ambientTemperature": 293.15
     },
     "regions": [
      {
       "id": "sheet",
       "name": "Sheet",
       "materialId": "mat-ex-lab-polymer",
       "thickness": 0.04,
       "cells": 40,
       "objectId": "ex-lab-sheet"
      }
     ],
     "domains": [
      {
       "id": "heat",
       "kind": "thermal",
       "solver": "thermal.conduction.fv",
       "settings": {
        "volumetricSource": 20000.0,
        "faces": {
         "-z": {
          "kind": "convective",
          "h": 50.0
         },
         "+z": {
          "kind": "convective",
          "h": 50.0
         }
        }
       }
      }
     ],
     "couplings": [],
     "materialLaws": [],
     "scheme": {
      "kind": "one-way",
      "maxIterations": 10,
      "temperatureTolerance": 1e-07
     }
    }
   ]
  }
 }
