   "studies": [
    {
     "id": "st-thermal",
     "name": "The sheet's conductivity from a heating run",
     "objective": "Calibrate the sheet's thermal conductivity against its mid-plane temperature",
     "hypothesis": "The handbook conductivity (0.40 W/(m K)) underestimates this batch",
     "domain": "thermal",
     "specimen": "a 40 mm polymer sheet with an embedded heater",
     "operator": "",
     "status": "planned",
     "models": [
      {
       "kind": "physical-system",
       "id": "sys-lab-slab",
       "revision": "",
