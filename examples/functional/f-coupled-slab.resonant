  "multiphysics": {
   "format": "resonant.multiphysics",
   "version": 1,
   "systems": [
    {
     "format": "resonant.physical-system",
     "version": 1,
     "id": "sys-microwave-heated-slab",
     "name": "Microwave-heated slab",
     "description": "A 10 mm lossy dielectric slab, 100 x 100 mm, in a 2.45 GHz plane wave of 20 kW/m^2 (2 W/cm^2), cooled by convection on both faces. Its loss tangent rises with temperature (an illustrative law), it expands, and the thicker slab changes the wave solution: iterated to a fixed point.",
     "geometry": {
      "kind": "layered-slab",
      "lateralArea": 0.01
     },
     "environment": {
      "ambientTemperature": 293.15,
      "incidenceMaterial": "",
      "exitMaterial": ""
     },
     "regions": [
      {
       "id": "slab",
       "name": "Slab",
       "materialId": "mat-ex-lossy-dielectric",
       "thickness": 0.01,
       "cells": 50,
       "objectId": "ex-multiphysics-slab"
      }
     ],
     "domains": [
      {
       "id": "em",
       "kind": "electromagnetic",
       "solver": "em.layered.transfer-matrix",
       "settings": {
        "frequencyHz": 2450000000.0,
        "incidentIntensity": 20000.0
       }
      },
      {
       "id": "heat",
       "kind": "thermal",
       "solver": "thermal.conduction.fv",
       "settings": {
        "faces": {
         "-z": {
          "kind": "convective",
          "h": 20.0,
          "ambient": 293.15
         },
         "+z": {
          "kind": "convective",
          "h": 20.0,
          "ambient": 293.15
         }
        }
       }
      },
      {
       "id": "solid",
       "kind": "mechanical",
       "solver": "mechanics.fe.solid-column",
       "settings": {
        "lateral": "free"
       }
      }
     ],
     "couplings": [
      {
       "id": "absorption",
       "model": "em.absorption-to-heat",
       "from": "em",
       "to": "heat"
      },
      {
       "id": "loss-vs-temperature",
       "model": "thermal.temperature-to-em-properties",
       "from": "heat",
       "to": "em"
      },
      {
       "id": "expansion",
       "model": "thermal.expansion",
       "from": "heat",
       "to": "solid"
      },
      {
       "id": "deformation",
       "model": "mechanics.deformation-to-geometry",
       "from": "solid",
       "to": "em"
      }
     ],
     "materialLaws": [
      {
       "region": "slab",
       "property": "electromagnetic.lossTangent",
       "law": "linear",
       "value": 0.05,
       "reference": 293.15,
       "slope": 0.0002,
       "validity": [
        273.15,
        450.0
       ],
       "provenance": "illustrative",
       "source": "illustrative: loss rising 0.4 % per kelvin, typical of polar polymers"
      }
     ],
     "scheme": {
      "kind": "iterative",
      "passes": 2,
      "maxIterations": 50,
      "temperatureTolerance": 0.0001,
      "geometryTolerance": 1e-09,
      "relaxation": 1.0,
      "balanceTolerance": 1e-06
     },
     "observations": [
      {
       "id": "centre",
       "point": [
        0,
        0,
        0.005
       ]
      }
     ]
    }
   ]
  },
  "functional": {
   "format": "resonant.functional",
   "version": 1,
   "structures": [
    {
     "format": "resonant.functional-structure",
     "version": 1,
     "id": "fs-coupled-slab",
     "name": "Microwave-heated slab",
     "description": "The microwave-heated slab of the coupled engine as a functional structure: its thickness, a box height, drives absorption, heating and stress.",
     "bodies": [
      {
       "objectId": "ex-multiphysics-slab",
       "role": "slab"
      }
     ],
     "parameters": [
      {
       "id": "thickness",
       "name": "Slab thickness",
       "kind": "bound",
       "binding": "object/ex-multiphysics-slab/geometry/height",
       "unit": "m",
       "min": 0.002,
       "max": 0.05,
       "group": "geometry"
      }
     ],
     "regions": [
      {
       "id": "r-slab",
       "objectId": "ex-multiphysics-slab",
       "role": "slab",
       "materialId": "mat-ex-lossy-dielectric"
      }
     ],
     "domains": [
      "electromagnetic",
      "thermal",
      "mechanical"
     ],
     "physicalSystem": "sys-microwave-heated-slab",
     "analysis": {
      "kind": "multiphysics.coupled-slab",
      "model": "",
      "settings": {}
     },
     "objectives": [
      {
       "id": "o-abs",
       "metric": "coupled.absorptance",
       "sense": "maximize",
       "weight": 1.0
      }
     ],
     "constraints": [
      {
       "id": "c-temp",
       "expression": "[coupled.peakTemperature]",
       "relation": "<=",
       "limit": 400.0,
       "unit": "K",
       "category": "physical",
       "hard": true,
       "description": "the polymer must stay below 400 K"
      }
     ]
    }
   ]
  }
 }
}